<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Compare curated Travlr Getaways reef destinations.">
  <title>{{title}} | Travlr Getaways</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  {{> header}}

  <main>
    <section class="page-hero">
      <div class="shell page-hero__content">
        <p class="eyebrow">Destination collection</p>
        <h1>Choose your reef escape.</h1>
        <p>Three distinct coastlines, one uncomplicated way to compare the essentials.</p>
      </div>
    </section>

    <section class="section shell" aria-labelledby="trips-title">
      <div class="section-heading section-heading--row">
        <div>
          <p class="eyebrow">Available journeys</p>
          <h2 id="trips-title">Featured trips</h2>
        </div>
        <a class="text-link" href="/">Back to home</a>
      </div>

      {{#if message}}
        <p class="notice" role="status">{{message}}</p>
      {{/if}}

      <div class="trip-grid">
        {{#each trips}}
          <article class="trip-card">
            <a class="trip-card__image-link" href="/api/trips/{{this.code}}" aria-label="View {{this.name}} API record">
              <img class="trip-card__image" src="/images/{{this.image}}" alt="Coastal view for {{this.name}}">
            </a>
            <div class="trip-card__body">
              <div class="trip-card__heading">
                <div>
                  <p class="trip-card__resort">{{this.resort}}</p>
                  <h3>{{this.name}}</h3>
                </div>
                <p class="trip-card__price">{{formatCurrency this.perPerson}}<span> / person</span></p>
              </div>
              <p class="trip-card__description">{{this.description}}</p>
              <dl class="trip-card__details">
                <div><dt>Duration</dt><dd>{{this.length}}</dd></div>
                <div><dt>Starts</dt><dd>{{formatDate this.start}}</dd></div>
                <div><dt>Trip code</dt><dd>{{this.code}}</dd></div>
              </dl>
            </div>
          </article>
        {{/each}}
      </div>
    </section>
  </main>

  {{> footer}}
</body>
</html>
