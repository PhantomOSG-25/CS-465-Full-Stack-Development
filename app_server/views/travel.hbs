<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
  <div id="background">
    <div id="page">
      {{> header}}

      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>Travel</h1>
              <ul id="sites">

              {{#each trips}}
                <li>
                  <!-- Image links to the API (returns json for single trip) -->
                  <a href="/api/trips/{{this.code}}">
                    <img src="/images/{{this.image}}" alt="{{this.name}}">
                  </a>

                  <!-- Trip name links to the trip details page -->
                  <h2>
                    <a href="/travel/{{this.code}}">{{this.name}}</a>
                  </h2>

                  {{{this.description}}}
                </li>
              {{/each}}
              </ul>
            </div>
          </div>
        </div>
      </div>

      {{> footer}}
    </div>

    <p>© 2023 by BHACCASYONIZTAS BEACH RESORT. All Rights Reserved</p>
  </div>
</body>
</html>
